--- a/game.css
+++ b/game.css
@@ -1413,3 +1413,59 @@
   font-weight:700;
 }
 
+
+/* Game gestures only: preserve browser pinch zoom and selectable information. */
+#app button, #fieldStage, .battle-toolbar, .battle-controls {
+  -webkit-user-select: none;
+  user-select: none;
+  -webkit-touch-callout: none;
+}
+#fieldStage { touch-action: manipulation; }
+/* Text entry and informational/result text retain native selection/copy. */
+#app input, #app textarea, #app [contenteditable="true"] {
+  -webkit-user-select: text;
+  user-select: text;
+  -webkit-touch-callout: default;
+}
+
+/* Restrained strengths: ordinary values remain parchment ink. Gold marks at
+   most one characteristic metric and one concrete trait, never winning odds. */
+.comparison-list {
+  --strength-ink:#76520e; --strength-bg:#f9ecc7; --strength-rule:#a0813c;
+}
+.units-side .comparison-list {
+  --strength-ink:#f1d185; --strength-bg:#3b5140; --strength-rule:#c3a460;
+}
+#comparison .comparison-trait[data-tone] { color:#59452e; background:#eadfca; border-color:#aa9471; }
+.units-side .comparison-trait[data-tone] { color:#e4dcc8; background:transparent; border-color:#a48e63; }
+#comparison .comparison-stat[data-emphasis="true"], .units-side .comparison-stat[data-emphasis="true"] {
+  background:var(--strength-bg); box-shadow:inset 2px 0 var(--strength-rule);
+}
+#comparison .comparison-stat[data-emphasis="true"] .comparison-stat-value,
+#comparison .comparison-mobility-item[data-emphasis="true"] .comparison-mobility-value,
+.units-side .comparison-stat[data-emphasis="true"] .comparison-stat-value,
+.units-side .comparison-mobility-item[data-emphasis="true"] .comparison-mobility-value { color:var(--strength-ink); }
+#comparison .comparison-trait[data-emphasis="true"], .units-side .comparison-trait[data-emphasis="true"] {
+  color:var(--strength-ink); background:var(--strength-bg); border-color:var(--strength-rule); font-weight:800;
+}
+.comparison-strength-mark { color:var(--strength-ink); font:700 9px/1 system-ui,sans-serif; margin-inline-start:3px; vertical-align:middle; }
+@media (forced-colors:active) {
+  #comparison .comparison-stat[data-emphasis="true"], .units-side .comparison-stat[data-emphasis="true"] { box-shadow:none; }
+}
+
+/* Selection details stay in normal flow outside the canvas. No projectile/body overlay. */
+.crowd-inspector { flex:0 0 auto; min-height:64px; display:grid; grid-template-columns:minmax(0,1fr) repeat(3,44px); gap:4px; align-items:center; padding:4px 6px; border:1px solid #8b9b79; border-radius:4px; background:#1d2c24; color:#f5e9c6; }
+.crowd-inspector[hidden] { display:none; }
+.crowd-inspector-copy { min-width:0; display:grid; gap:2px; line-height:1.3; }
+#crowdFocusName { overflow-wrap:anywhere; font-size:13px; font-weight:700; }
+#crowdFocusHP { font-size:13px; font-variant-numeric:tabular-nums; }
+#app .crowd-inspector button { min-width:44px; min-height:44px; padding:2px; font-size:24px; line-height:1; color:#f5e9c6; background:#304738; border:1px solid #809a78; border-radius:4px; }
+#app .crowd-inspector button:disabled { opacity:.45; }
+#app .crowd-inspector button:focus-visible, #field:focus-visible { outline:3px solid #ffe8a2; outline-offset:2px; }
+
+/* The existing desktop field is absolutely positioned. Reserve a distinct band
+   below it instead of letting this new normal-flow panel cover that field. */
+@media (min-width:900px) and (min-height:640px) {
+ #gameScreen[data-field-view="true"] #battle[data-crowd-inspector="true"] .field-stage { bottom:68px; }
+ #gameScreen[data-field-view="true"] .crowd-inspector { position:absolute; left:0; right:84px; bottom:0; min-height:64px; }
+}
