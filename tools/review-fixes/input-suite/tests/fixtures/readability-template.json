"let template=spec.text;\n  // Clarify phase endings without hiding, merging, or rewriting recorded events.\n  if(template.endsWith('が終了：{reason}')){\n   const action=template.slice(0,-'が終了：{reason}'.length);\n   template=d.reason==='complete'?action+'が完了':action+'が終了（{reason}）';\n  }\n  if(row.type==='combo_melee_contact')template='{source} → {target}：連撃の{subhitId}発目が命中';\n  if(['flight_projectile_end','projectile_end','orb_projectile_end','moon_projectile_end','counter_bolt_end'].includes(row.type)){\n   const shot=({flight_projectile_end:'追尾弾',projectile_end:'飛び道具',orb_projectile_end:'連射弾',moon_projectile_end:'貫通弾',counter_bolt_end:'反撃弾'})[row.type];\n   template=d.reason==='hit'?'{source}の'+shot+'が命中':d.reason==='blocked'?'{source}の'+shot+'が遮られた':'{source}の'+shot+'が消えた（{reason}）';\n  }"
