{
  "monsterIds": [
    "goblin",
    "golem",
    "drake",
    "wraith"
  ],
  "teamCapAlive": 32,
  "summons": {
    "parent": "wraith",
    "child": "goblin",
    "charges": 3,
    "initialDelaySeconds": 0.25,
    "cooldownSeconds": 1.5,
    "spawnToken": "${parentToken}/summon:${spawnCount}",
    "nextTick": true,
    "parentDeath": "already-queued-summons-persist"
  },
  "types": {
    "goblin": {
      "cost": 2,
      "name": "小鬼",
      "hp": 50,
      "dmg": 9,
      "range": 16,
      "rate": 0.62,
      "speed": 54,
      "attackTargetMask": [
        "ground"
      ],
      "collisionLayer": "ground",
      "radius": 7,
      "reach": 4
    },
    "golem": {
      "cost": 9,
      "name": "岩巨人",
      "hp": 390,
      "dmg": 50,
      "range": 27,
      "rate": 2.5,
      "speed": 15,
      "reach": 2,
      "attackTargetMask": [
        "ground"
      ],
      "collisionLayer": "ground",
      "mass": 2600,
      "radius": 25
    },
    "drake": {
      "cost": 7,
      "name": "羽トカゲ",
      "hp": 145,
      "dmg": 25,
      "range": 28,
      "rate": 1.15,
      "speed": 38,
      "reach": 12,
      "attackTargetMask": [
        "ground",
        "air"
      ],
      "collisionLayer": "air",
      "flying": true,
      "radius": 13
    },
    "wraith": {
      "cost": 8,
      "name": "亡霊術師",
      "hp": 90,
      "dmg": 15,
      "range": 88,
      "rate": 1.3,
      "speed": 22,
      "projectile": true,
      "attackTargetMask": [
        "ground",
        "air"
      ],
      "collisionLayer": "ground",
      "summonCharges": 3,
      "summonInitialDelay": 0.25,
      "summonCooldown": 1.5,
      "radius": 9,
      "reach": 63
    }
  },
  "combatEventApi": {
    "sinks": [
      "global combatEvents array",
      "global emitCombatEvent(record) callback"
    ],
    "noSink": "no event allocations; simulation parity tested",
    "events": [
      {
        "type": "resolved_hit",
        "fields": [
          "targetToken",
          "source",
          "sourceToken",
          "sourceKind",
          "x",
          "y",
          "amount"
        ],
        "amount": "post-armor hit amount, not net HP delta"
      },
      {
        "type": "heal",
        "fields": [
          "source",
          "sourceToken",
          "target",
          "targetToken",
          "x",
          "y",
          "actualAmount"
        ],
        "actualAmount": "capped restorative amount, accounting for same-tick damage"
      },
      {
        "type": "projectile_release",
        "fields": [
          "source",
          "sourceToken",
          "k",
          "target",
          "targetToken",
          "x",
          "y"
        ]
      },
      {
        "type": "golem_ground_contact",
        "fields": [
          "source",
          "sourceToken",
          "target",
          "targetToken",
          "x",
          "y"
        ],
        "semantics": "melee contact only; no AoE"
      },
      {
        "type": "summon_spawn",
        "fields": [
          "parentToken",
          "childToken",
          "k",
          "side",
          "x",
          "y"
        ],
        "semantics": "emitted on next-tick insertion"
      }
    ],
    "payload": "frozen primitives; no entity object references",
    "healingIndependentOfAttackTargetMask": true
  }
}
