[hidden]{display:none!important}.wallet{display:grid;grid-template-columns:repeat(3,1fr);gap:6px;margin:12px 0}.wallet div{background:#212d30;padding:8px;text-align:center}.wallet span{display:block;font-size:11px;color:#b8b29e}.wallet strong{font-size:18px}h2{font-size:16px;margin:12px 0 8px}.stakes{display:grid;grid-template-columns:repeat(4,1fr);gap:6px;margin:8px 0}button[aria-pressed=true]{outline:3px solid #f7d994;outline-offset:-3px}.panel{margin:12px 0;padding:12px;border:1px solid #52605a;border-radius:5px}.hint{font-size:12px;line-height:1.6;color:#c3beac}.breakdown{white-space:pre-line;line-height:1.8;font-size:14px}#confirm{width:100%;margin:8px 0}#skip{font-size:13px;background:#212d30}#phaseTitle{color:#e9c97f}canvas{max-height:54vh;width:auto;max-width:100%;margin:auto}
